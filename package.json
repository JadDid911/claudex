{
  "name": "@jaddid911/claudex",
  "version": "0.4.1",
  "description": "One visible, delegation-first terminal room for Codex and Claude.",
  "author": "JadDid911",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadDid911/claudex.git"
  },
  "homepage": "https://github.com/JadDid911/claudex#readme",
  "bugs": {
    "url": "https://github.com/JadDid911/claudex/issues"
  },
  "type": "module",
  "files": [
    "bin",
    "src",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./config": "./src/config.js",
    "./orchestrator": "./src/orchestrator.js",
    "./providers": "./src/providers/index.js"
  },
  "bin": {
    "claudex": "./bin/claudex.js"
  },
  "scripts": {
    "start": "node ./bin/claudex.js",
    "demo": "node ./bin/claudex.js --demo",
    "check": "node ./scripts/check.js",
    "test": "node --test --test-reporter spec \"test/**/*.test.js\"",
    "verify": "npm run check && npm test",
    "pack:dry-run": "npm pack --dry-run --json",
    "verify:release": "npm run check && npm test",
    "prepack": "npm run verify:release",
    "prepublishOnly": "npm run verify:release"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claudex",
    "codex",
    "claude",
    "terminal",
    "delegation",
    "tui"
  ],
  "license": "MIT"
}
